# Workroom runs in mock mode when these are empty.
# Do not commit real values. Copy this file to .env.local.

# Public URL used in magic links and Stripe return URLs.
# NEXT_PUBLIC_APP_URL=https://workroom.quvantic.com

# Session signing. Required before any real users. The repo fallback is public and only for the demo.
# AUTH_SECRET=

# Supabase. Use the publishable key (or the legacy anon key) plus the URL.
# Apply supabase/migrations, then npm run seed with the secret key.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Stripe test mode. Leave empty to use the simulated checkout.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional project summaries. The app writes a local summary when both are empty.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
